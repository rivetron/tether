# Tether Environment Variables for Tether
# Copy this file to .env and customize the values

# Server Configuration
SERVER_PORT=8080
SERVER_HOST=0.0.0.0
BASE_URL=http://localhost:8080
GIN_MODE=debug

# =============================================================================
# CHOOSE YOUR SETUP:
# =============================================================================

# Option 1: LOCAL DEVELOPMENT (Use when running app with `make dev-air`)
# Uncomment these lines if Docker services are running on localhost:
MONGO_URI=mongodb://tether:tether123@localhost:27017/tether?authSource=admin
MONGO_DATABASE=tether
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=tether123

# Option 2: DOCKER DEVELOPMENT (Use when running app inside Docker)
# Uncomment these lines if running everything in Docker:
# MONGO_URI=mongodb://tether:tether123@mongodb:27017/tether?authSource=admin
# MONGO_DATABASE=tether
# REDIS_ADDR=redis:6379
# REDIS_PASSWORD=tether123

# =============================================================================

REDIS_DB=0

# Logging
LOG_LEVEL=info

# Security (comma-separated for arrays)
ALLOWED_ORIGINS=*
BLOCKED_DOMAINS=malicious-site.org

# Feature Flags
ENABLE_STATS=true
ENABLE_GEOIP=true
